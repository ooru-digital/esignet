# CredIssuer plugin — staging (active)
# mosip.esignet.authenticator.credissuer.send-otp-url=https://staging-api.credissuer.com/api/credentials/send-otp/
# mosip.esignet.authenticator.credissuer.verify-otp-url=https://staging-api.credissuer.com/api/credentials/verify-otp
# mosip.esignet.authenticator.credissuer.bearer-token=97a8565c386608873d7cac933cbca995f6b42a2c

# CredIssuer plugin — prod (uncomment and comment staging above to switch)
mosip.esignet.authenticator.credissuer.send-otp-url=https://api.credissuer.com/api/credentials/send-otp/
mosip.esignet.authenticator.credissuer.verify-otp-url=https://api.credissuer.com/api/credentials/verify-otp
mosip.esignet.authenticator.credissuer.bearer-token=5965e3b390e35fc3f428b9ca24c0e7e65d99162e


mosip.esignet.integration.scan-base-package=io.mosip.authentication.esignet.integration,io.mosip.esignet.credissuer.integration
mosip.esignet.integration.binding-validator=BindingValidatorServiceImpl
mosip.esignet.integration.authenticator=CredissuerAuthenticationService
mosip.esignet.integration.key-binder=NoOpKeyBinder
mosip.esignet.integration.audit-plugin=LoggerAuditService
mosip.esignet.integration.captcha-validator=GoogleRecaptchaValidatorService
mosip.esignet.authenticator.credissuer.encrypt-kyc=true

# Required by CredissuerAuthenticationService (@Value has no default)
mosip.esignet.mock.authenticator.ida.otp-channels=email,phone
mosip.esignet.authenticator.ida.otp-channels=email,phone

# Must match wallet credential issuer authorization_servers (no /esignet suffix).
# issuer + authorization_endpoint are derived from this value.
mosip.esignet.domain.url=https://collectible-dissentiently-arie.ngrok-free.dev

# VCI scopes — mock_identity_vc_ldp matches Inji Certify (local-prod.json)
mosip.esignet.supported.credential.scopes={'mosip_identity_vc_ldp','mock_identity_vc_ldp'}
mosip.esignet.credential.scope-resource-mapping={'mosip_identity_vc_ldp':'https://collectible-dissentiently-arie.ngrok-free.dev/v1/esignet/vci/credential','mock_identity_vc_ldp':'https://collectible-dissentiently-arie.ngrok-free.dev/certify/v1/certify/issuance/credential'}
